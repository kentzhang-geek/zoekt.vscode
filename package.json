{
  "name": "zoekt-vscode",
  "displayName": "zoekt.vscode",
  "description": "A extension to connect zoekt webserver in vscode, for faster code search and jump",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelTool:zoekt-search",
    "onChatParticipant:zoekt-vscode.zoekt-participant"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Zoekt",
      "properties": {
        "zoekt.url": {
          "type": "string",
          "default": "http://127.0.0.1:6070",
          "description": "The URL of the zoekt-webserver"
        },
        "zoekt.prefix": {
          "type": "array",
          "default": [],
          "description": "List of search prefixes. Each item should have a 'name' and 'prefix'.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for the prefix"
              },
              "prefix": {
                "type": "string",
                "description": "The prefix string (e.g. 'r:my-repo')"
              }
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "zoekt-vscode.search",
        "title": "Zoekt: Search"
      },
      {
        "command": "zoekt-vscode.selectPrefix",
        "title": "Zoekt: Switch Prefix"
      },
      {
        "command": "zoekt-vscode.showMcpConfig",
        "title": "Zoekt: Show MCP Config"
      }
    ],
    "languageModelTools": [
      {
        "name": "zoekt-search",
        "tags": [
          "search",
          "code",
          "zoekt"
        ],
        "toolReferenceName": "zoekt",
        "displayName": "Zoekt Code Search",
        "userDescription": "Search for code patterns in the codebase using Zoekt (supports Regex).",
        "modelDescription": "Search for code patterns in the entire codebase using Zoekt. \n\nIMPORTANT USAGE RULES:\n1. Supports REGEX. Use regex for fuzzy matching logic.\n   - BAD: 'init setup context'\n   - GOOD: '(init|setup).+context'\n2. Use Zoekt syntax for filtering:\n   - 'defs:MyClass' (definitions)\n   - 'r:my-repo' (repo filter)\n   - 'file:\\.cpp$' (file extension)\n3. Returns file paths, line numbers, and snippets.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "The search query. STRONGLY PREFER REGEX (e.g., '(foo|bar).+baz') for multiple terms."
            },
            "prefix": {
              "type": "string",
              "description": "Optional search prefix (e.g., 'r:my-repo') to restrict scope."
            }
          },
          "required": [
            "query"
          ]
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "zoekt-vscode.zoekt-participant",
        "name": "zoekt",
        "description": "Search code using Zoekt",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3"
  }
}