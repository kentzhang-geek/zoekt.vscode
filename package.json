{
  "name": "zoekt-vscode",
  "displayName": "zoekt.vscode",
  "description": "A extension to connect zoekt webserver in vscode, for faster code search and jump",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Zoekt",
      "properties": {
        "zoekt.url": {
          "type": "string",
          "default": "http://127.0.0.1:6070",
          "description": "The URL of the zoekt-webserver"
        },
        "zoekt.prefix": {
          "type": "array",
          "default": [],
          "description": "List of search prefixes. Each item should have a 'name' and 'prefix'.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name for the prefix"
              },
              "prefix": {
                "type": "string",
                "description": "The prefix string (e.g. 'r:my-repo')"
              }
            }
          }
        },
        "zoekt.maxResults": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 2000,
          "description": "Maximum number of matched files to display (MaxDocDisplayCount)"
        },
        "zoekt.contextLines": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 10,
          "description": "Number of context lines before and after each match (NumContextLines)"
        }
      }
    },
    "commands": [
      {
        "command": "zoekt-vscode.search",
        "title": "Zoekt: Search",
        "icon": "$(search)"
      },
      {
        "command": "zoekt-vscode.selectPrefix",
        "title": "Zoekt: Switch Prefix",
        "icon": "$(filter)"
      },
      {
        "command": "zoekt-vscode.selectRepo",
        "title": "Zoekt: Select Repository",
        "icon": "$(repo)"
      },
      {
        "command": "zoekt-vscode.clearResults",
        "title": "Zoekt: Clear Results",
        "icon": "$(clear-all)"
      },
      {
        "command": "zoekt-vscode.refreshSearch",
        "title": "Zoekt: Refresh Search",
        "icon": "$(refresh)"
      },
      {
        "command": "zoekt-vscode.deleteSearch",
        "title": "Zoekt: Close Search Result",
        "icon": "$(close)"
      },
      {
        "command": "zoekt-vscode.openResult",
        "title": "Zoekt: Open Result"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zoekt",
          "title": "Zoekt Search",
          "icon": "$(search)"
        }
      ]
    },
    "views": {
      "zoekt": [
        {
          "id": "zoektResults",
          "name": "Search Results"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "zoekt-vscode.search",
          "when": "view == zoektResults",
          "group": "navigation@1"
        },
        {
          "command": "zoekt-vscode.selectRepo",
          "when": "view == zoektResults",
          "group": "navigation@2"
        },
        {
          "command": "zoekt-vscode.selectPrefix",
          "when": "view == zoektResults",
          "group": "navigation@3"
        },
        {
          "command": "zoekt-vscode.clearResults",
          "when": "view == zoektResults",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "zoekt-vscode.refreshSearch",
          "when": "view == zoektResults && viewItem == zoektSearch",
          "group": "inline@1"
        },
        {
          "command": "zoekt-vscode.deleteSearch",
          "when": "view == zoektResults && viewItem == zoektSearch",
          "group": "inline@2"
        },
        {
          "command": "zoekt-vscode.refreshSearch",
          "when": "view == zoektResults && viewItem == zoektSearch",
          "group": "1_actions@1"
        },
        {
          "command": "zoekt-vscode.deleteSearch",
          "when": "view == zoektResults && viewItem == zoektSearch",
          "group": "1_actions@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
